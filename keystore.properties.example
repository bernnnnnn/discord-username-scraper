# Copy this file to `keystore.properties` (which is git-ignored) and fill in your
# OWN release signing key. Never commit the real file or the keystore itself.
#
# Generate a fresh key with:
#   keytool -genkeypair -v -keystore my-release.jks -alias noctra \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the project root.
storeFile=my-release.jks
storePassword=CHANGE_ME
keyAlias=noctra
keyPassword=CHANGE_ME
